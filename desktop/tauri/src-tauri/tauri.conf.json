{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeeChat",
  "version": "0.1.0",
  "identifier": "com.jiuwenswarm.beechat",
  "build": {
    "frontendDist": "../../../bee/dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm --prefix ../../bee run dev",
    "beforeBuildCommand": "npm --prefix ../../bee run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "avatar",
        "title": "BeeChat",
        "url": "index.html#avatar",
        "width": 300,
        "height": 420,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
