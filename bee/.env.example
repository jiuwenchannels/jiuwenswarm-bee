# Leave unset to auto-try the local gateways (using 127.0.0.1 so browsers do
# not pick the IPv6 ::1 address, which the gateway does not bind):
#   1. ws://127.0.0.1:19000/ws       (jiuwenswarm product gateway, web protocol)
#   2. ws://127.0.0.1:19001/v1/ws    (SDK gateway, envelope protocol)
#   3. ws://127.0.0.1:19000/v1/ws    (SDK gateway on the documented port)
# Set this to pin a specific gateway.
VITE_JIUWENSWARM_URL=

# Protocol for a pinned URL: "product" or "sdk".
# If unset, it is inferred (URL containing /v1/ws => sdk, else product).
VITE_GATEWAY_PROTOCOL=

# Bearer token for the SDK gateway's `connect` envelope (optional)
VITE_GATEWAY_TOKEN=

# Agent used by the SDK gateway's `create_session` (optional)
VITE_AGENT_ID=researcher

# Product-gateway mode sent with chat.send (e.g. agent, code.normal)
VITE_AGENT_MODE=agent

# Brand title shown in the header
VITE_APP_TITLE=BeeChat
