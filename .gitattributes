# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Binary assets (never diff or convert)
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.exe binary
*.msi binary
*.dll binary

# Generated lockfiles: collapse in diffs and language stats
package-lock.json -diff linguist-generated
Cargo.lock -diff linguist-generated
